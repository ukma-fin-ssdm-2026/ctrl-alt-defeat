@startuml
actor "User" as User
participant "Frontend\n(React)" as UI
participant "API Router\n(FastAPI)" as Router
participant "Security\n(JWT Validator)" as Sec
participant "Rating Service\n(Business Logic)" as Service
participant "Data Access\n(PostgreSQL)" as DB

User -> UI : Clicks rating score (e.g., 9/10)
activate UI

UI -> Router : POST /api/ratings {content_id, score}\n[Cookie: access_token]
activate Router

Router -> Sec : validate_token(cookie/header)
activate Sec
alt #MistyRose Token invalid or expired
    Sec --> Router : TokenExpired / Invalid
    Router --> UI : 401 Unauthorized
    UI --> User : Prompt login / redirect
else #LightCyan Token valid
    Sec --> Router : current_user {user_id}
    deactivate Sec

    Router -> Service : rate_content(user_id, content_id, score)
    activate Service

    Service -> DB : Check if content in WatchedItem(user_id, content_id)
    activate DB
    DB --> Service : watched_status
    deactivate DB

    alt #MistyRose FR-003 Violation: Content not in Watched List
        Service --> Router : ContentNotWatchedError
        Router --> UI : 403 Forbidden ("Must be in Watched List to rate")
        UI --> User : Show notification ("Add to Watched first")
    else #LightCyan Content is watched
        alt #MistyRose Invalid score (not in 1..10)
            Service --> Router : ValidationError
            Router --> UI : 422 Unprocessable Entity
            UI --> User : Show validation error
        else #LightGreen Valid input & watched
            Service -> DB : BEGIN TRANSACTION\nUPSERT Rating(user_id, content_id, score)\nUPDATE Content average_rating, rating_count\nCOMMIT
            activate DB
            alt #MistyRose Database Error / Conflict
                DB --> Service : DBException / Timeout
                Service -> DB : ROLLBACK
                Service --> Router : DatabaseError
                Router --> UI : 500 Internal Server Error
                UI --> User : Show server error message
            else #LightGreen Transaction committed
                DB --> Service : Rating saved & aggregates updated
                deactivate DB

                Service --> Router : RatingResponse
                Router --> UI : 201 Created {rating_id, score}
                UI --> User : Update UI rating widget
            end
        end
    end
end
deactivate Service
deactivate Router
deactivate UI
@enduml
