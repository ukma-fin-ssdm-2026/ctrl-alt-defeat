@startuml
skinparam componentStyle uml2

package "Presentation Tier (Frontend)" {
    [UI Components & Views] as UI_Comp
    [Client State Management] as UI_State
    [API Client (Axios)] as UI_Client

    UI_Comp --> UI_State : manages
    UI_Comp --> UI_Client : dispatches requests
}

package "Application Tier (FastAPI Backend)" {
    () "HTTP/REST API" as HTTP_Interface

    package "Presentation Layer (Controllers)" {
        [API Routers & Handlers] as Controllers
        note right of Controllers
          /api/v1/auth
          /api/v1/movies
          /api/v1/reviews
          /api/v1/watchlist
          /api/v1/users/me/watched
          /api/v1/recommendations
        end note
    }

    package "Security & Auth Module" {
        [JWT & Security Middleware] as Security
        note bottom of Security
          Stateless JWT validation
          from HttpOnly Cookie
          / Bearer header
        end note
    }

    package "Business Logic Layer (Services)" {
        () "Service Interface" as Service_Interface
        [Rating & Review Services] as Logic_Review
        [Content & Search Service] as Logic_Content
        [Recommendation Engine] as Logic_Rec
        [TMDB Sync Client] as Logic_TMDB
    }

    package "Data Access Layer (DAL)" {
        () "Repository Interface" as Repo_Interface
        [ORM Repositories (SQLAlchemy)] as DAL
    }

    HTTP_Interface - Controllers
    Controllers ..> Security : authenticate & authorize
    Controllers --> Service_Interface : invokes
    Service_Interface - Logic_Review
    Service_Interface - Logic_Content
    Service_Interface - Logic_Rec

    Logic_Review --> Repo_Interface : persists & queries
    Logic_Content --> Repo_Interface : queries
    Logic_Rec --> Repo_Interface : reads history & ratings
    Repo_Interface - DAL
}

package "Data Tier" {
    database "PostgreSQL (Primary DB)" as DB {
        [Tables: Users, Content, Ratings, Reviews, Watched, Watchlist]
    }
}

cloud "TMDB External API" as TMDB

UI_Client --> HTTP_Interface : HTTPS / JSON (Cookie / Bearer)
DAL --> DB : SQL over TCP (:5432)
Logic_TMDB --> TMDB : HTTPS (REST API)

@enduml
