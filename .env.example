# Copy to .env and fill in your own values (.env is gitignored).
# Read by `uvicorn ... --env-file .env`, scripts/seed_movies.py and docker-compose.yml.
# Random values: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Database: without it a local SQLite file app.db is used (docker-compose.yml sets its own DATABASE_URL).
# DATABASE_URL=postgresql://user:password@localhost:5432/reviews_db

# JWT signing key. Without it a random key is used and sessions end on every restart.
JWT_SECRET_KEY=

# Accounts created on startup (verified and active). An account is created only when its password is set;
# on every start the password and role of an existing account are synced with these values.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=

# true = show the seed accounts (with passwords) in the login window. Only for demo deployments.
DEMO_MODE=false
# Which seed accounts the login window may show (admin,user). A public site uses only: user
DEMO_ROLES=admin,user

# Email with the activation link (FR-001). Without BREVO_API_KEY or SMTP_HOST the link is only printed
# in the server log. Brevo (HTTP API, free 300 emails/day) also works on hosts that block SMTP ports.
EMAIL_FROM=
EMAIL_FROM_NAME=Після титрів
BREVO_API_KEY=
# SMTP alternative, e.g. Gmail: smtp.gmail.com, 587, your address, an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Public site address used in email links (default http://localhost:5173)
APP_BASE_URL=

# Optional: real catalog from TMDB instead of the built-in fallback set
TMDB_API_KEY=

# docker-compose.yml only: PostgreSQL password for the local database container
POSTGRES_PASSWORD=
